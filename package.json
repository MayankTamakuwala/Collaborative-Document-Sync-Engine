{
  "name": "collab-sync-engine",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time collaborative document editing over WebSockets, backed by a sequence CRDT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "npm run -w @collab/server start",
    "demo": "npm run -w @collab/demo dev",
    "bench": "vite-node bench/latency.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
